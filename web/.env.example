# Optional Phase-1 event sink. If set, commercial events are also posted
# to this Google Apps Script webhook URL (a "controlled Sheet", per the
# Master Build Directive Section 11) in addition to the always-on server
# log. Leave unset to just use the server log — nothing breaks either way.
KHATORE_EVENTS_SHEET_WEBHOOK_URL=

# Optional: same pattern, for recording created orders (lib/order/store.ts).
KHATORE_ORDERS_SHEET_WEBHOOK_URL=

# Optional: same pattern, for recording leads (lib/leads/store.ts).
KHATORE_LEADS_SHEET_WEBHOOK_URL=

# --- Payment gateway credentials (Master Website Upgrade, Section 12/17) ---
# ALL unset today -- this deployment has no active payment gateway.
# Setting a provider's variables below is the ONLY way to activate it
# (see lib/payment/providers.ts); do this only once Khatore's merchant
# account with that provider is actually approved. Never commit real
# values here or anywhere else -- this file stays empty placeholders.

# Cashfree (evaluated first -- see the payment gateway evaluation report)
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_WEBHOOK_SECRET=
CASHFREE_ENV=

# Razorpay -- IMPLEMENTED (lib/payment/razorpay.ts). RAZORPAY_KEY_ID +
# RAZORPAY_KEY_SECRET activate createSession (real Orders API call).
# RAZORPAY_WEBHOOK_SECRET (separate, from the Razorpay dashboard's
# webhook settings, NOT the API secret) activates verifyWebhook's HMAC
# check. Use TEST-mode keys only until a real transaction has been
# verified end-to-end -- see STATUS.md.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# PayPal -- IMPLEMENTED (lib/payment/paypal.ts). PAYPAL_CLIENT_ID +
# PAYPAL_CLIENT_SECRET activate createSession (real Orders v2 API call,
# now including the return/cancel URLs so the customer actually comes
# back to the site -- 8 Oct) and the post-approval captureOrder() call
# that app/api/payments/return's GET handler uses as the real,
# authoritative "paid" confirmation (never the redirect alone). The
# separate async JSON webhook path (verifyWebhook) still always returns
# invalid -- the call to PayPal's verify-webhook-signature endpoint is
# not wired in yet (see STATUS.md) -- but that path is no longer the
# only way a PayPal payment gets confirmed. PAYPAL_WEBHOOK_ID is
# required for that separate path. PAYPAL_ENV: "sandbox" (default) or "live".
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_ENV=sandbox

# PayU -- IMPLEMENTED (lib/payment/payu.ts), 8 Oct: client's lead gateway
# for India (UPI, cards, net banking all handled inside PayU's own
# hosted payment page -- no separate integration per method).
# PAYU_MERCHANT_KEY + PAYU_MERCHANT_SALT activate createSession (real
# SHA-512 request-hash, built and unit-tested against PayU's documented
# formula, independently verified against a live round-trip in this
# repo's own dev server -- see STATUS.md). PayU's authoritative
# confirmation arrives as a signed browser redirect to
# app/api/payments/return, not a JSON webhook -- that route verifies
# the reverse hash before ever showing a "paid" state. Use TEST-mode
# keys (PAYU_ENV unset/"test") until a real transaction has been
# verified end-to-end.
PAYU_MERCHANT_KEY=
PAYU_MERCHANT_SALT=
PAYU_ENV=test

# --- Dashboard (Area 2) ---
# Required to view /dashboard. No default -- the dashboard route
# refuses to render without this set (see app/dashboard).
KHATORE_DASHBOARD_PASSWORD=

# Optional: email notification for new leads/orders (lib/notify.ts).
# Leave unset and notifications are logged only, same as events/orders.
KHATORE_NOTIFY_EMAIL_TO=
RESEND_API_KEY=

# --- Pricing demo mode (Area 3) ---
# When "1", clearly-labelled DEMO pricing data is used so the country
# tier + discount-expiry mechanism can be demonstrated even though real
# Tier 1/2 local-currency amounts haven't been confirmed yet. Must be
# unset/"0" in production -- see lib/pricing/config.ts.
DEMO_PRICING=

# "Lowest price in 30 days" badge (components/Pricing/PriceTag.tsx) --
# OFF by default (client decision, 8 Oct): there is no real 30-day price
# history yet, so the badge must not show until that history genuinely
# exists. NEXT_PUBLIC_-prefixed because PriceTag is a client component.
NEXT_PUBLIC_SHOW_LOWEST_PRICE_BADGE=
